@using eKvarovi.App.Services

@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

@implements IDisposable

<MudNavMenu>

    @if (!CurrentUser.IsInitialized)
    {
        <MudText Typo="Typo.caption" Class="pa-3">
            Učitavanje...
        </MudText>
    }
    else if (!CurrentUser.IsLoggedIn)
    {
        <MudNavLink Href="/login"
                    Icon="@Icons.Material.Filled.Login">
            Prijava
        </MudNavLink>
    }
    else
    {
        <MudNavLink Href="/"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.Home">
            Home
        </MudNavLink>

        @if (CurrentUser.HasRole("Admin"))
        {
            <MudNavLink Href="/locations"
                        Icon="@Icons.Material.Filled.LocationOn">
                Lokacije
            </MudNavLink>

            <MudNavLink Href="/employees"
                        Icon="@Icons.Material.Filled.People">
                Djelatnici
            </MudNavLink>

            <MudNavLink Href="/technicians"
                        Icon="@Icons.Material.Filled.Engineering">
                Izvršitelji
            </MudNavLink>
        }

        <MudDivider Class="my-2" />

        <MudText Typo="Typo.caption"
                 Class="px-4 py-2">
            @CurrentUser.User?.DisplayName
        </MudText>

        <MudText Typo="Typo.caption"
                 Class="px-4 pb-2">
            @string.Join(", ", CurrentUser.User?.Roles ?? new())
        </MudText>

        <MudNavLink Icon="@Icons.Material.Filled.Logout"
                    OnClick="HandleLogout">
            Odjava
        </MudNavLink>
    }

</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        CurrentUser.UserChanged += HandleUserChanged;
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender)
        {
            await CurrentUser.InitializeAsync();
        }
    }

    private void HandleUserChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        await CurrentUser.LogoutAsync();

        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        CurrentUser.UserChanged -= HandleUserChanged;
    }
}
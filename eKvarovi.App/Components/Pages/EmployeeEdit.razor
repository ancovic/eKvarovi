@page "/employees/edit/{Id:int}"
@rendermode InteractiveServer

@using eKvarovi.Shared.DTOs
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">
    Uredi djelatnika
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <EditForm Model="model"
              OnValidSubmit="SaveEmployee"
              FormName="employee-edit">

        <MudPaper Class="pa-4">

            <MudTextField Label="Ime"
                          @bind-Value="model.FirstName"
                          Required="true"
                          Class="mb-3" />

            <MudTextField Label="Prezime"
                          @bind-Value="model.LastName"
                          Required="true"
                          Class="mb-3" />

            <MudTextField Label="Email"
                          @bind-Value="model.Email"
                          Required="true"
                          Class="mb-3" />

            <MudTextField Label="Telefon"
                          @bind-Value="model.Phone"
                          Class="mb-3" />

            <MudSelect T="int"
                       Label="Lokacija"
                       @bind-Value="model.LocationId"
                       Required="true"
                       Class="mb-3">

                @foreach (var location in locations)
                {
                    <MudSelectItem T="int"
                                   Value="@location.Id">
                        @location.Name
                    </MudSelectItem>
                }

            </MudSelect>

            <MudCheckBox T="bool"
                         Label="Aktivan djelatnik"
                         @bind-Value="model.IsActive"
                         Class="mb-3" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                Spremi
            </MudButton>

            <MudButton Href="/employees"
                       Variant="Variant.Text"
                       Class="ml-2">
                Odustani
            </MudButton>

        </MudPaper>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private SaveEmployeeDto model = new();

    private List<LookupDto> locations = new();

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            locations =
                await Http.GetFromJsonAsync<List<LookupDto>>(
                    "api/locations/lookup")
                ?? new();

            var employee =
                await Http.GetFromJsonAsync<EmployeeDto>(
                    $"api/employees/{Id}");

            if (employee is null)
            {
                errorMessage = "Djelatnik nije pronađen.";
                return;
            }

            // dodano u slucaju ako je employee vezan za lokaciju koja
            // je u medjuvremenu deaktivirana
            if (!locations.Any(location =>
                    location.Id == employee.LocationId))
            {
                locations.Add(new LookupDto
                {
                    Id = employee.LocationId,
                    Name = employee.LocationName
                });
            }

            model = new SaveEmployeeDto
            {
                FirstName = employee.FirstName,
                LastName = employee.LastName,
                Email = employee.Email,
                Phone = employee.Phone,
                IsActive = employee.IsActive,
                LocationId = employee.LocationId
            };
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Greška kod učitavanja djelatnika: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveEmployee()
    {
        if (string.IsNullOrWhiteSpace(model.FirstName) ||
            string.IsNullOrWhiteSpace(model.LastName))
        {
            errorMessage =
                "Ime i prezime djelatnika su obavezni.";

            return;
        }

        if (string.IsNullOrWhiteSpace(model.Email))
        {
            errorMessage = "Email djelatnika je obavezan.";
            return;
        }

        if (model.LocationId == 0)
        {
            errorMessage = "Odaberi lokaciju.";
            return;
        }

        try
        {
            var response =
                await Http.PutAsJsonAsync(
                    $"api/employees/{Id}",
                    model);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    await response.Content.ReadAsStringAsync();

                return;
            }

            Navigation.NavigateTo("/employees");
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Greška kod spremanja djelatnika: {ex.Message}";
        }
    }
}
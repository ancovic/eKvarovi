@page "/faultreports/{Id:int}"
@rendermode InteractiveServer

@using eKvarovi.App.Services
@using eKvarovi.Shared.DTOs
@using System.Net.Http.Json

@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Detalji prijave</PageTitle>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true"
                         Color="Color.Primary" />
}
else if (report is null)
{
    <MudAlert Severity="Severity.Warning">
        Prijava nije pronađena.
    </MudAlert>
}
else
{
    <MudStack Spacing="3">

        <MudPaper Class="pa-5">

            <MudText Typo="Typo.h4" Class="mb-3">
                @report.Title
            </MudText>

            <MudChip T="string"
                     Color="@GetStatusColor(report.FaultStatusName)"
                     Class="mb-4">
                @report.FaultStatusName
            </MudChip>

            <MudGrid>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">
                        Lokacija
                    </MudText>

                    <MudText>
                        @report.LocationName
                    </MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">
                        Prijavitelj
                    </MudText>

                    <MudText>
                        @report.ReporterName
                    </MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">
                        Vrsta kvara
                    </MudText>

                    <MudText>
                        @(report.FaultTypeName ?? "-")
                    </MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">
                        Prioritet
                    </MudText>

                    <MudText>
                        @(report.FaultPriorityName ?? "-")
                    </MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">
                        Datum prijave
                    </MudText>

                    <MudText>
                        @report.CreatedAt.ToString("dd.MM.yyyy. HH:mm")
                    </MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">
                        Rok
                    </MudText>

                    <MudText>
                        @(report.DueDate?.ToString("dd.MM.yyyy.") ?? "-")
                    </MudText>
                </MudItem>

            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle2"
                     Class="mb-2">
                Opis problema
            </MudText>

            <MudText>
                @report.Description
            </MudText>

        </MudPaper>

        <MudPaper Class="pa-5">

            <MudText Typo="Typo.h5"
                     Class="mb-3">
                Početne fotografije
            </MudText>

            @if (BeforePhotos.Count == 0)
            {
                <MudText>
                    Za ovu prijavu nema početnih fotografija.
                </MudText>
            }
            else
            {
                <MudGrid>

                    @foreach (var media in BeforePhotos)
                    {
                        <MudItem xs="12"
                                 sm="6"
                                 md="4">

                            <MudCard>

                                <img src="@media.Url"
                                     alt="@media.OriginalFileName"
                                     style="width:100%;height:240px;object-fit:cover;display:block;" />

                                <MudCardContent>

                                    <MudText Typo="Typo.body2">
                                        @media.OriginalFileName
                                    </MudText>

                                    <MudText Typo="Typo.caption">
                                        @FormatBytes(media.FileSize)
                                        ·
                                        @media.UploadedAt.ToString("dd.MM.yyyy. HH:mm")
                                    </MudText>

                                </MudCardContent>

                                @if (CanDeleteBeforePhoto)
                                {
                                    <MudCardActions>

                                        <MudButton Color="Color.Error"
                                                   OnClick="@(() => DeleteMedia(media.Id))">
                                            Izbriši
                                        </MudButton>

                                    </MudCardActions>
                                }

                            </MudCard>

                        </MudItem>
                    }

                </MudGrid>
            }

        </MudPaper>

        <MudPaper Class="pa-5">

            <MudText Typo="Typo.h5"
                     Class="mb-3">
                Radni nalog
            </MudText>

            @if (latestAssignment is null)
            {
                <MudText>
                    Prijava još nije dodijeljena izvršitelju.
                </MudText>
            }
            else
            {
                <MudGrid>

                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.subtitle2">
                            Izvršitelj
                        </MudText>

                        <MudText>
                            @latestAssignment.TechnicianName
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.subtitle2">
                            Dodijeljeno
                        </MudText>

                        <MudText>
                            @latestAssignment.AssignedAt.ToString("dd.MM.yyyy. HH:mm")
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.subtitle2">
                            Nalog
                        </MudText>

                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(latestAssignment.IsActive ? Color.Success : Color.Default)">
                            @(latestAssignment.IsActive
                                ? "Aktivan"
                                : "Završen")
                        </MudChip>
                    </MudItem>

                    @if (!string.IsNullOrWhiteSpace(
                            latestAssignment.Note))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2">
                                Bilješka
                            </MudText>

                            <MudText>
                                @latestAssignment.Note
                            </MudText>
                        </MudItem>
                    }

                </MudGrid>
            }

            @if (CanManage &&
                 report is not null &&
                 report.FaultStatusName != "Zaprimljeno" &&
                 report.FaultStatusName != "Riješeno" &&
                 report.FaultStatusName != "Zatvoreno")
            {
                <MudDivider Class="my-4" />

                <MudText Typo="Typo.h6"
                         Class="mb-3">
                    @(latestAssignment?.IsActive == true
                        ? "Ponovna dodjela"
                        : "Dodijeli izvršitelja")
                </MudText>

                <MudSelect T="int?"
                           Label="Izvršitelj"
                           @bind-Value="selectedTechnicianId"
                           Required="true"
                           Variant="Variant.Outlined"
                           Class="mb-3">

                    @foreach (var technician in technicians)
                    {
                        <MudSelectItem T="int?"
                                       Value="@((int?)technician.Id)">
                            @technician.Name
                        </MudSelectItem>
                    }

                </MudSelect>

                <MudTextField T="string"
                              Label="Bilješka naloga"
                              @bind-Value="assignmentNote"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Class="mb-3" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="AssignTechnician"
                           Disabled="isAssigning">

                    @(isAssigning
                        ? "Spremanje..."
                        : latestAssignment?.IsActive == true
                            ? "Ponovno dodijeli"
                            : "Dodijeli")

                </MudButton>
            }

        </MudPaper>

        <MudPaper Class="pa-5">

            <MudText Typo="Typo.h5"
                     Class="mb-3">
                Intervencije i rezultat
            </MudText>

            @if (interventions.Count == 0)
            {
                <MudText>
                    Za ovu prijavu još nema intervencija.
                </MudText>
            }
            else
            {
                @foreach (var intervention in interventions)
                {
                    var usedMaterials =
                        materialsByIntervention.TryGetValue(
                            intervention.Id,
                            out var interventionMaterials)
                            ? interventionMaterials
                            : new List<InterventionMaterialDto>();

                    <MudPaper Class="pa-3 mb-3">

                        <MudStack Row="true"
                                  Spacing="2"
                                  Class="mb-3">

                            <MudText Typo="Typo.h6">
                                Intervencija #@intervention.Id
                            </MudText>

                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="@GetInterventionStatusColor(
                                                                      intervention.InterventionStatusName)">
                                @intervention.InterventionStatusName
                            </MudChip>

                        </MudStack>

                        <MudGrid>

                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.subtitle2">
                                    Izvršitelj
                                </MudText>

                                <MudText>
                                    @intervention.TechnicianName
                                </MudText>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.subtitle2">
                                    Početak
                                </MudText>

                                <MudText>
                                    @(intervention.StartedAt?.ToString(
                                        "dd.MM.yyyy. HH:mm") ?? "-")
                                </MudText>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.subtitle2">
                                    Završetak
                                </MudText>

                                <MudText>
                                    @(intervention.FinishedAt?.ToString(
                                        "dd.MM.yyyy. HH:mm") ?? "-")
                                </MudText>
                            </MudItem>

                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2">
                                    Rezultat / bilješka rada
                                </MudText>

                                <MudText>
                                    @(intervention.WorkNote ?? "-")
                                </MudText>
                            </MudItem>

                        </MudGrid>

                        @if (CanManage)
                        {
                            <MudDivider Class="my-3" />

                            <MudText Typo="Typo.subtitle2"
                                     Class="mb-2">
                                Utrošeni materijal
                            </MudText>

                            @if (usedMaterials.Count == 0)
                            {
                                <MudText>
                                    Nema evidentiranog materijala.
                                </MudText>
                            }
                            else
                            {
                                <MudTable Items="@usedMaterials"
                                          Dense="true"
                                          Bordered="true">

                                    <HeaderContent>
                                        <MudTh>Materijal</MudTh>
                                        <MudTh>Količina</MudTh>
                                        <MudTh>Jedinica</MudTh>
                                    </HeaderContent>

                                    <RowTemplate>

                                        <MudTd DataLabel="Materijal">
                                            @context.MaterialName
                                        </MudTd>

                                        <MudTd DataLabel="Količina">
                                            @context.Quantity
                                        </MudTd>

                                        <MudTd DataLabel="Jedinica">
                                            @context.MaterialUnitName
                                        </MudTd>

                                    </RowTemplate>

                                    <NoRecordsContent>
                                        <MudText Class="pa-3">
                                            Nema evidentiranog materijala.
                                        </MudText>
                                    </NoRecordsContent>

                                </MudTable>
                            }
                        }

                    </MudPaper>
                }
            }

        </MudPaper>

        <MudPaper Class="pa-5">

            <MudText Typo="Typo.h5"
                     Class="mb-3">
                Privitci nakon rada
            </MudText>

            <MudText Typo="Typo.h6"
                     Class="mb-3">
                Fotografije nakon rada
            </MudText>

            @if (AfterPhotos.Count == 0)
            {
                <MudText Class="mb-4">
                    Nema fotografija nakon rada.
                </MudText>
            }
            else
            {
                <MudGrid Class="mb-4">

                    @foreach (var media in AfterPhotos)
                    {
                        <MudItem xs="12"
                                 sm="6"
                                 md="4">

                            <MudCard>

                                <img src="@media.Url"
                                     alt="@media.OriginalFileName"
                                     style="width:100%;height:240px;object-fit:cover;display:block;" />

                                <MudCardContent>

                                    <MudText Typo="Typo.body2">
                                        @media.OriginalFileName
                                    </MudText>

                                    <MudText Typo="Typo.caption">
                                        @FormatBytes(media.FileSize)
                                        ·
                                        @media.UploadedAt.ToString(
                                            "dd.MM.yyyy. HH:mm")
                                    </MudText>

                                </MudCardContent>

                                <MudCardActions>

                                    <MudButton Href="@media.Url"
                                               Target="_blank">
                                        Otvori
                                    </MudButton>

                                </MudCardActions>

                            </MudCard>

                        </MudItem>
                    }

                </MudGrid>
            }

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6"
                     Class="mb-3">
                Dokumenti
            </MudText>

            @if (Documents.Count == 0)
            {
                <MudText>
                    Nema dokumenata.
                </MudText>
            }
            else
            {
                <MudTable Items="@Documents"
                          Dense="true"
                          Bordered="true">

                    <HeaderContent>
                        <MudTh>Datoteka</MudTh>
                        <MudTh>Veličina</MudTh>
                        <MudTh>Dodano</MudTh>
                        <MudTh>Pregled</MudTh>
                    </HeaderContent>

                    <RowTemplate>

                        <MudTd DataLabel="Datoteka">
                            @context.OriginalFileName
                        </MudTd>

                        <MudTd DataLabel="Veličina">
                            @FormatBytes(context.FileSize)
                        </MudTd>

                        <MudTd DataLabel="Dodano">
                            @context.UploadedAt.ToString(
                                "dd.MM.yyyy. HH:mm")
                        </MudTd>

                        <MudTd DataLabel="Pregled">
                            <MudButton Href="@context.Url"
                                       Target="_blank">
                                Otvori
                            </MudButton>
                        </MudTd>

                    </RowTemplate>

                    <NoRecordsContent>
                        <MudText Class="pa-3">
                            Nema dokumenata.
                        </MudText>
                    </NoRecordsContent>

                </MudTable>
            }

        </MudPaper>

        @if (CanManage)
        {
            <MudPaper Class="pa-5">

                <MudText Typo="Typo.h5"
                         Class="mb-3">
                    Povijest dodjela
                </MudText>

                <MudTable Items="@assignmentHistory"
                          Hover="true"
                          Dense="true"
                          Bordered="true">

                    <HeaderContent>
                        <MudTh>Izvršitelj</MudTh>
                        <MudTh>Dodijeljeno</MudTh>
                        <MudTh>Završeno</MudTh>
                        <MudTh>Aktivan</MudTh>
                        <MudTh>Bilješka</MudTh>
                    </HeaderContent>

                    <RowTemplate>

                        <MudTd DataLabel="Izvršitelj">
                            @context.TechnicianName
                        </MudTd>

                        <MudTd DataLabel="Dodijeljeno">
                            @context.AssignedAt.ToString("dd.MM.yyyy. HH:mm")
                        </MudTd>

                        <MudTd DataLabel="Završeno">
                            @(context.EndedAt?.ToString("dd.MM.yyyy. HH:mm") ?? "-")
                        </MudTd>

                        <MudTd DataLabel="Aktivan">
                            @(context.IsActive ? "Da" : "Ne")
                        </MudTd>

                        <MudTd DataLabel="Bilješka">
                            @(context.Note ?? "-")
                        </MudTd>

                    </RowTemplate>

                    <NoRecordsContent>
                        <MudText Class="pa-3">
                            Prijava još nema dodjela.
                        </MudText>
                    </NoRecordsContent>

                </MudTable>

            </MudPaper>
        }

        <MudStack Row="true"
                  Spacing="2">

            @if (CanManage)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="@($"/faultreports/edit/{Id}")">
                    Uredi prijavu
                </MudButton>
            }

            <MudButton Variant="Variant.Outlined"
                       Href="@BackUrl">
                Natrag
            </MudButton>

        </MudStack>

    </MudStack>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private FaultReportDto? report;
    private List<FaultMediaDto> mediaItems = new();

    private WorkAssignmentDto? latestAssignment;
    private List<WorkAssignmentDto> assignmentHistory = new();
    private List<LookupDto> technicians = new();
    private List<InterventionDto> interventions = new();

    private Dictionary<int, List<InterventionMaterialDto>> materialsByIntervention =
        new();

    private int? selectedTechnicianId;
    private string? assignmentNote;

    private bool isAssigning;

    private bool isLoading = true;
    private string? errorMessage;

    private bool CanManage =>
        CurrentUser.HasAnyRole(
            "Admin",
            "Manager");

    private bool CanDeleteBeforePhoto =>
        CurrentUser.HasRole("Admin") ||
        (CurrentUser.HasRole("Reporter") &&
         report?.FaultStatusName == "Zaprimljeno");

    private string BackUrl =>
        CurrentUser.HasRole("Reporter") &&
        !CanManage
            ? "/myreports"
            : "/faultreports";

    private List<FaultMediaDto> BeforePhotos =>
        mediaItems
            .Where(media =>
                media.Purpose == "BeforePhoto")
            .ToList();

    private List<FaultMediaDto> AfterPhotos =>
    mediaItems
        .Where(media =>
            media.Purpose == "AfterPhoto")
        .ToList();

    private List<FaultMediaDto> Documents =>
        mediaItems
            .Where(media =>
                media.Purpose == "Document")
            .ToList();

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await CurrentUser.InitializeAsync();

        if (!CurrentUser.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadProfile();

        StateHasChanged();
    }

    private async Task LoadProfile()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            report =
                await Http.GetFromJsonAsync<FaultReportDto>(
                    $"api/faultreports/{Id}");

            mediaItems =
                await Http.GetFromJsonAsync<List<FaultMediaDto>>(
                    $"api/faultreports/{Id}/media")
                ?? new();

            if (CanManage ||
                CurrentUser.HasRole("Reporter") ||
                CurrentUser.HasRole("Technician"))
            {
                var assignmentResponse =
                    await Http.GetAsync(
                        $"api/workassignments/faultreport/{Id}/latest");

                if (assignmentResponse.StatusCode ==
                    System.Net.HttpStatusCode.NoContent)
                {
                    latestAssignment = null;
                }
                else if (assignmentResponse.IsSuccessStatusCode)
                {
                    latestAssignment =
                        await assignmentResponse.Content
                            .ReadFromJsonAsync<WorkAssignmentDto>();
                }
                else
                {
                    latestAssignment = null;
                }
            }

            if (CanManage)
            {
                assignmentHistory =
                    await Http.GetFromJsonAsync<List<WorkAssignmentDto>>(
                        $"api/workassignments?faultReportId={Id}")
                    ?? new();

                technicians =
                    await Http.GetFromJsonAsync<List<LookupDto>>(
                        "api/technicians/lookup")
                    ?? new();
            }

            await LoadInterventionData();
        }
        catch (HttpRequestException ex)
        {
            errorMessage =
                $"Prijavu nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteMedia(
        int mediaId)
    {
        var confirmed =
            await DialogService.ShowMessageBoxAsync(
                "Brisanje fotografije",
                "Želiš li sigurno izbrisati ovu fotografiju?",
                yesText: "Izbriši",
                cancelText: "Odustani");

        if (confirmed != true)
        {
            return;
        }

        errorMessage = null;

        try
        {
            var response =
                await Http.DeleteAsync(
                    $"api/faultreports/{Id}/media/{mediaId}");

            if (!response.IsSuccessStatusCode)
            {
                var message =
                    await response.Content
                        .ReadAsStringAsync();

                errorMessage =
                    string.IsNullOrWhiteSpace(message)
                        ? "Fotografiju nije moguće izbrisati."
                        : message.Trim('"');

                return;
            }

            await LoadProfile();
        }
        catch (HttpRequestException ex)
        {
            errorMessage =
                $"Fotografiju nije moguće izbrisati: {ex.Message}";
        }
    }

    private async Task AssignTechnician()
    {
        errorMessage = null;

        if (!selectedTechnicianId.HasValue ||
            selectedTechnicianId.Value <= 0)
        {
            errorMessage =
                "Odaberi izvršitelja.";

            return;
        }

        isAssigning = true;

        try
        {
            var request =
                new SaveWorkAssignmentDto
                {
                    FaultReportId = Id,
                    TechnicianId =
                        selectedTechnicianId.Value,

                    Note =
                        string.IsNullOrWhiteSpace(
                            assignmentNote)
                            ? null
                            : assignmentNote.Trim()
                };

            var response =
                await Http.PostAsJsonAsync(
                    "api/workassignments",
                    request);

            if (!response.IsSuccessStatusCode)
            {
                var message =
                    await response.Content
                        .ReadAsStringAsync();

                errorMessage =
                    string.IsNullOrWhiteSpace(message)
                        ? "Radni nalog nije moguće spremiti."
                        : message.Trim('"');

                return;
            }

            selectedTechnicianId = null;
            assignmentNote = null;

            await LoadProfile();
        }
        catch (HttpRequestException ex)
        {
            errorMessage =
                $"Radni nalog nije moguće spremiti: {ex.Message}";
        }
        finally
        {
            isAssigning = false;
        }
    }

    private async Task LoadInterventionData()
    {
        interventions.Clear();
        materialsByIntervention.Clear();

        if (CanManage)
        {
            foreach (var assignment in assignmentHistory)
            {
                var assignmentInterventions =
                    await Http.GetFromJsonAsync<List<InterventionDto>>(
                        $"api/interventions/workassignment/{assignment.Id}")
                    ?? new();

                interventions.AddRange(
                    assignmentInterventions);
            }
        }
        else if (latestAssignment is not null)
        {
            var assignmentInterventions =
                await Http.GetFromJsonAsync<List<InterventionDto>>(
                    $"api/interventions/workassignment/{latestAssignment.Id}")
                ?? new();

            interventions.AddRange(
                assignmentInterventions);
        }

        interventions =
            interventions
                .OrderByDescending(intervention =>
                    intervention.CreatedAt)
                .ToList();

        if (CanManage)
        {
            foreach (var intervention in interventions)
            {
                var materials =
                    await Http.GetFromJsonAsync<List<InterventionMaterialDto>>(
                        $"api/interventions/{intervention.Id}/materials")
                    ?? new();

                materialsByIntervention[intervention.Id] =
                    materials;
            }
        }
    }

    private static Color GetInterventionStatusColor(
    string status)
    {
        return status switch
        {
            "Planirana" => Color.Default,
            "U tijeku" => Color.Warning,
            "Završena" => Color.Success,
            "Neuspješna" => Color.Error,
            _ => Color.Default
        };
    }

    private static Color GetStatusColor(
        string status)
    {
        return status switch
        {
            "Zaprimljeno" => Color.Info,
            "Pregledano" => Color.Primary,
            "Dodijeljeno" => Color.Secondary,
            "U radu" => Color.Warning,
            "Riješeno" => Color.Success,
            "Zatvoreno" => Color.Default,
            _ => Color.Default
        };
    }

    private static string FormatBytes(
        long bytes)
    {
        return bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.0} MB"
            : $"{bytes / 1024d:0.0} KB";
    }
}
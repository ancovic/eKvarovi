@page "/technicians"
@rendermode InteractiveServer

@using eKvarovi.Shared.DTOs
@using System.Net.Http.Json

@inject HttpClient Http
@inject IDialogService DialogService

<MudText Typo="Typo.h4" GutterBottom="true">Izvršitelji</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudTextField @bind-Value="searchString"
                          Label="Pretraži izvršitelje"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>

        <MudItem xs="12" md="5">
            <MudSelect T="bool?"
                       Label="Status"
                       @bind-Value="selectedIsActive"
                       Variant="Variant.Outlined"
                       Clearable="true">

                <MudSelectItem T="bool?"
                               Value="@((bool?)true)">
                    Aktivni
                </MudSelectItem>

                <MudSelectItem T="bool?"
                               Value="@((bool?)false)">
                    Neaktivni
                </MudSelectItem>

            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Spacing="2" Class="mt-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="LoadTechnicians">
            Primijeni filtere
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   OnClick="ResetFilters">
            Reset filtera
        </MudButton>
    </MudStack>
</MudPaper>

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary" />
    </div>
}
else
{
    <MudButton Href="/technicians/create"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add">
        Novi izvršitelj
    </MudButton>

    <MudTable Items="FilteredTechnicians"
              Hover="true"
              Striped="true"
              Bordered="true"
              Dense="true">

        <HeaderContent>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<TechnicianDto, object>(x => x.LastName)">
                    Izvršitelj
                </MudTableSortLabel>
            </MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Telefon</MudTh>
            <MudTh>Specijalizacija</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Uredi</MudTh>
            <MudTh>Obriši</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Izvršitelj">
                @context.FirstName @context.LastName
            </MudTd>

            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Telefon">@context.Phone</MudTd>
            <MudTd DataLabel="Specijalizacija">
                @context.Specialization
            </MudTd>

            <MudTd DataLabel="Status">
                <MudChip T="string"
                         Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Aktivan" : "Neaktivan")
                </MudChip>
            </MudTd>

            <MudTd DataLabel="Uredi">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Href="@($"/technicians/edit/{context.Id}")" />
            </MudTd>

            <MudTd DataLabel="Obriši">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="@(() => DeleteTechnician(context))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Typo="Typo.body1" Class="pa-4">
                Nema rezultata za zadane kriterije pretrage i filtera.
            </MudText>
        </NoRecordsContent>

    </MudTable>
}

@code {
    private List<TechnicianDto> technicians = new();

    private string searchString = string.Empty;
    private bool? selectedIsActive;

    private bool isLoading = true;
    private string? errorMessage;

    private IEnumerable<TechnicianDto> FilteredTechnicians =>
        technicians.Where(TechnicianMatchesSearch);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadTechnicians();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Greška kod učitavanja stranice: {ex.Message}";

            isLoading = false;
        }
    }

    private async Task LoadTechnicians()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var query = new List<string>();

            if (selectedIsActive.HasValue)
            {
                query.Add(
                    $"isActive={selectedIsActive.Value.ToString().ToLowerInvariant()}");
            }

            var url = "api/technicians";

            if (query.Count > 0)
            {
                url += "?" + string.Join("&", query);
            }

            technicians =
                await Http.GetFromJsonAsync<List<TechnicianDto>>(url)
                ?? new();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Greška kod dohvaćanja izvršitelja: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool TechnicianMatchesSearch(TechnicianDto technician)
    {
        if (string.IsNullOrWhiteSpace(searchString))
        {
            return true;
        }

        return technician.FirstName.Contains(
                   searchString,
                   StringComparison.OrdinalIgnoreCase)
               || technician.LastName.Contains(
                   searchString,
                   StringComparison.OrdinalIgnoreCase)
               || technician.Email.Contains(
                   searchString,
                   StringComparison.OrdinalIgnoreCase)
               || (technician.Phone ?? string.Empty).Contains(
                   searchString,
                   StringComparison.OrdinalIgnoreCase)
               || (technician.Specialization ?? string.Empty).Contains(
                   searchString,
                   StringComparison.OrdinalIgnoreCase);
    }

    private async Task ResetFilters()
    {
        searchString = string.Empty;
        selectedIsActive = null;

        await LoadTechnicians();
    }

    private async Task DeleteTechnician(TechnicianDto technician)
    {
        try
        {
            var confirmed =
                await DialogService.ShowMessageBoxAsync(
                    "Brisanje izvršitelja",
                    $"Želite li obrisati izvršitelja '{technician.FirstName} {technician.LastName}'?",
                    yesText: "Da",
                    noText: "Ne");

            if (confirmed != true)
            {
                return;
            }

            var response =
                await Http.DeleteAsync(
                    $"api/technicians/{technician.Id}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    await response.Content.ReadAsStringAsync();

                return;
            }

            await LoadTechnicians();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Greška kod brisanja izvršitelja: {ex.Message}";
        }
    }
}
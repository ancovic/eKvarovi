@page "/myassignments"
@rendermode InteractiveServer

@using eKvarovi.App.Services
@using eKvarovi.Shared.DTOs
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms

@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Moji radni nalozi</PageTitle>

<MudText Typo="Typo.h4"
         GutterBottom="true">
    Moji radni nalozi
</MudText>

<MudText Typo="Typo.body1"
         Class="mb-4">
    Prikazani su tvoji aktivni i završeni radni nalozi.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error"
              Class="mb-4">
        @errorMessage
    </MudAlert>
}

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true"
                         Color="Color.Primary" />
}
else
{
    <MudTable Items="@assignments"
              Hover="true"
              Striped="true"
              Bordered="true"
              Dense="true">

        <HeaderContent>
            <MudTh>Prijava</MudTh>
            <MudTh>Lokacija</MudTh>
            <MudTh>Status prijave</MudTh>
            <MudTh>Nalog</MudTh>
            <MudTh>Dodijeljeno</MudTh>
            <MudTh>Završeno</MudTh>
            <MudTh>Bilješka</MudTh>
            <MudTh>Detalji</MudTh>
        </HeaderContent>

        <RowTemplate>

            <MudTd DataLabel="Prijava">
                @context.FaultReportTitle
            </MudTd>

            <MudTd DataLabel="Lokacija">
                @context.LocationName
            </MudTd>

            <MudTd DataLabel="Status prijave">
                @context.FaultStatusName
            </MudTd>

            <MudTd DataLabel="Nalog">
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Aktivan" : "Završen")
                </MudChip>
            </MudTd>

            <MudTd DataLabel="Dodijeljeno">
                @context.AssignedAt.ToString("dd.MM.yyyy. HH:mm")
            </MudTd>

            <MudTd DataLabel="Završeno">
                @(context.EndedAt?.ToString("dd.MM.yyyy. HH:mm") ?? "-")
            </MudTd>

            <MudTd DataLabel="Bilješka">
                @(context.Note ?? "-")
            </MudTd>

            <MudTd DataLabel="Detalji">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Primary"
                               Href="@($"/faultreports/{context.FaultReportId}")" />
            </MudTd>

        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">
                Nemaš dodijeljenih radnih naloga.
            </MudText>
        </NoRecordsContent>

    </MudTable>

    @foreach (var assignment in assignments)
    {
        var assignmentInterventions =
                    interventionsByAssignment.TryGetValue(
                        assignment.Id,
                        out var items)
                        ? items
                        : new List<InterventionDto>();

        var activeIntervention =
            assignmentInterventions
                .FirstOrDefault(intervention =>
                    intervention.FinishedAt is null);

        <MudPaper Class="pa-4 mt-4">

            <MudText Typo="Typo.h6">
                @assignment.FaultReportTitle
            </MudText>

            <MudText Typo="Typo.body2"
                     Class="mb-3">
                @assignment.LocationName
            </MudText>

            @if (assignmentInterventions.Count == 0)
            {
                <MudText Class="mb-3">
                    Još nema intervencija.
                </MudText>
            }
            else
            {
                <MudTable Items="@assignmentInterventions"
                          Dense="true"
                          Bordered="true"
                          Class="mb-3">

                    <HeaderContent>
                        <MudTh>Status</MudTh>
                        <MudTh>Početak</MudTh>
                        <MudTh>Završetak</MudTh>
                        <MudTh>Bilješka</MudTh>
                    </HeaderContent>

                    <RowTemplate>

                        <MudTd DataLabel="Status">
                            @context.InterventionStatusName
                        </MudTd>

                        <MudTd DataLabel="Početak">
                            @(context.StartedAt?.ToString("dd.MM.yyyy. HH:mm") ?? "-")
                        </MudTd>

                        <MudTd DataLabel="Završetak">
                            @(context.FinishedAt?.ToString("dd.MM.yyyy. HH:mm") ?? "-")
                        </MudTd>

                        <MudTd DataLabel="Bilješka">
                            @(context.WorkNote ?? "-")
                        </MudTd>

                    </RowTemplate>

                    <NoRecordsContent>
                        <MudText Class="pa-3">
                            Nema intervencija.
                        </MudText>
                    </NoRecordsContent>

                </MudTable>
            }

            @if (assignment.IsActive &&
                 activeIntervention is null)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="@(() => StartIntervention(assignment.Id))"
                           Disabled="isSaving">
                    Pokreni intervenciju
                </MudButton>
            }

            @if (assignment.IsActive &&
                 activeIntervention is not null)
            {
                var usedMaterials =
                            materialsByIntervention.TryGetValue(
                                activeIntervention.Id,
                                out var interventionMaterials)
                                ? interventionMaterials
                                : new List<InterventionMaterialDto>();

                var interventionMedia =
                            mediaByIntervention.TryGetValue(
                                activeIntervention.Id,
                                out var mediaItems)
                                ? mediaItems
                                : new List<FaultMediaDto>();

                <MudDivider Class="my-4" />

                    <MudText Typo="Typo.h6"
                             Class="mb-3">
                        Utrošeni materijal
                    </MudText>                    

                    @if (usedMaterials.Count > 0)
                    {
                        <MudTable Items="@usedMaterials"
                                  Dense="true"
                                  Bordered="true"
                                  Class="mb-3">

                            <HeaderContent>
                                <MudTh>Materijal</MudTh>
                                <MudTh>Količina</MudTh>
                                <MudTh>Jedinica</MudTh>
                            </HeaderContent>

                            <RowTemplate>
                                <MudTd DataLabel="Materijal">
                                    @context.MaterialName
                                </MudTd>

                                <MudTd DataLabel="Količina">
                                    @context.Quantity
                                </MudTd>

                                <MudTd DataLabel="Jedinica">
                                    @context.MaterialUnitName
                                </MudTd>
                            </RowTemplate>

                            <NoRecordsContent>
                                <MudText Class="pa-3">
                                    Nema evidentiranog materijala.
                                </MudText>
                            </NoRecordsContent>

                        </MudTable>
                    }

                    <MudGrid Class="mb-4">

                        <MudItem xs="12" md="6">

                            <MudSelect T="int?"
                                       Label="Materijal"
                                       Value="@GetSelectedMaterial(activeIntervention.Id)"
                                       ValueChanged="@((int? value) => SetSelectedMaterial(activeIntervention.Id, value))"
                                       Variant="Variant.Outlined">

                                @foreach (var material in availableMaterials)
                                {
                                    <MudSelectItem T="int?"
                                                   Value="@((int?)material.Id)">
                                        @($"{material.Name} ({material.MaterialUnitName})")
                                    </MudSelectItem>
                                }

                            </MudSelect>

                        </MudItem>

                        <MudItem xs="12" md="3">

                            <MudNumericField T="decimal?"
                                             Label="Količina"
                                             Value="@GetQuantity(activeIntervention.Id)"
                                             ValueChanged="@((decimal? value) => SetQuantity(activeIntervention.Id, value))"
                                             Variant="Variant.Outlined" />

                        </MudItem>

                        <MudItem xs="12" md="3">

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="@(() => AddMaterial(activeIntervention.Id))"
                                       Disabled="isSaving"
                                       Class="mt-2">
                                Dodaj materijal
                            </MudButton>

                        </MudItem>

                </MudGrid>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.h6"
                         Class="mb-3">
                    Privitci intervencije
                </MudText>

                @if (interventionMedia.Count == 0)
                {
                    <MudText Class="mb-3">
                        Intervencija još nema privitaka.
                    </MudText>
                }
                else
                {
                    <MudTable Items="@interventionMedia"
                              Dense="true"
                              Bordered="true"
                              Class="mb-4">

                        <HeaderContent>
                            <MudTh>Vrsta</MudTh>
                            <MudTh>Datoteka</MudTh>
                            <MudTh>Veličina</MudTh>
                            <MudTh>Pregled</MudTh>
                            <MudTh>Akcija</MudTh>
                        </HeaderContent>

                        <RowTemplate>

                            <MudTd DataLabel="Vrsta">
                                @GetMediaPurposeLabel(context.Purpose)
                            </MudTd>

                            <MudTd DataLabel="Datoteka">
                                @context.OriginalFileName
                            </MudTd>

                            <MudTd DataLabel="Veličina">
                                @FormatBytes(context.FileSize)
                            </MudTd>

                            <MudTd DataLabel="Pregled">
                                <a href="@context.Url"
                                   target="_blank">
                                    Otvori
                                </a>
                            </MudTd>

                            <MudTd DataLabel="Akcija">
                                <MudButton Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => DeleteMedia(
                                                                          assignment.FaultReportId,
                                                                          context.Id))">
                                    Izbriši
                                </MudButton>
                            </MudTd>

                        </RowTemplate>

                        <NoRecordsContent>
                            <MudText Class="pa-3">
                                Nema privitaka.
                            </MudText>
                        </NoRecordsContent>

                    </MudTable>
                }

                <MudGrid Class="mb-4">

                    <MudItem xs="12" md="6">

                        <MudText Typo="Typo.subtitle2"
                                 Class="mb-2">
                            Fotografija nakon rada
                        </MudText>

                        <InputFile OnChange="@((InputFileChangeEventArgs args) =>
                                                          HandleAfterPhotoSelected(
                                                              activeIntervention.Id,
                                                              args))"
                                   accept=".jpg,.jpeg,.png,.webp" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="isUploading"
                                   OnClick="@(() => UploadAfterPhoto(
                                                          assignment.FaultReportId,
                                                          activeIntervention.Id))"
                                   Class="mt-2">
                            Dodaj fotografiju
                        </MudButton>

                    </MudItem>

                    <MudItem xs="12" md="6">

                        <MudText Typo="Typo.subtitle2"
                                 Class="mb-2">
                            PDF dokument
                        </MudText>

                        <InputFile OnChange="@((InputFileChangeEventArgs args) =>
                                                          HandleDocumentSelected(
                                                              activeIntervention.Id,
                                                              args))"
                                   accept=".pdf" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="isUploading"
                                   OnClick="@(() => UploadDocument(
                                                          assignment.FaultReportId,
                                                          activeIntervention.Id))"
                                   Class="mt-2">
                            Dodaj dokument
                        </MudButton>

                    </MudItem>

                </MudGrid>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.h6"
                         Class="mb-3">
                    Završi intervenciju
                </MudText>

                <MudTextField T="string"
                              Label="Bilješka rada"
                              Value="@GetWorkNote(activeIntervention.Id)"
                              ValueChanged="@((string value) => SetWorkNote(activeIntervention.Id, value))"
                              Lines="4"
                              Required="true"
                              Variant="Variant.Outlined"
                              Class="mb-3" />

                <MudStack Row="true"
                          Spacing="2">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               OnClick="@(() => FinishIntervention(activeIntervention.Id, true))"
                               Disabled="isSaving">
                        Uspješno završena
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               OnClick="@(() => FinishIntervention(activeIntervention.Id, false))"
                               Disabled="isSaving">
                        Neuspješna
                    </MudButton>

                </MudStack>
            }

        </MudPaper>
    }
}

@code {
    private List<WorkAssignmentDto> assignments = new();

    private Dictionary<int, List<InterventionDto>> interventionsByAssignment =
        new();

    private Dictionary<int, string> workNotes =
        new();

    private List<MaterialDto> availableMaterials = new();

    private Dictionary<int, List<InterventionMaterialDto>> materialsByIntervention =
        new();

    private Dictionary<int, int?> selectedMaterialByIntervention =
        new();

    private Dictionary<int, decimal?> quantityByIntervention =
        new();

    private Dictionary<int, List<FaultMediaDto>> mediaByIntervention =
    new();

    private Dictionary<int, IBrowserFile?> afterPhotoByIntervention =
        new();

    private Dictionary<int, IBrowserFile?> documentByIntervention =
        new();

    private const long MaxFileSize =
        10 * 1024 * 1024;

    private bool isUploading;

    private bool isLoading = true;
    private bool isSaving;

    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await CurrentUser.InitializeAsync();

        if (!CurrentUser.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!CurrentUser.HasRole("Technician"))
        {
            errorMessage =
                "Nemaš ovlast za pregled vlastitih radnih naloga.";

            isLoading = false;
            StateHasChanged();
            return;
        }

        await LoadAssignments();

        StateHasChanged();
    }

    private async Task LoadAssignments()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            assignments =
                await Http.GetFromJsonAsync<List<WorkAssignmentDto>>(
                    "api/workassignments/mine")
                ?? new();

            availableMaterials =
                await Http.GetFromJsonAsync<List<MaterialDto>>(
                    "api/materials/lookup")
                ?? new();

            interventionsByAssignment.Clear();
            workNotes.Clear();

            materialsByIntervention.Clear();
            selectedMaterialByIntervention.Clear();
            quantityByIntervention.Clear();
            mediaByIntervention.Clear();

            foreach (var assignment in assignments)
            {
                var reportMedia =
                    await Http.GetFromJsonAsync<List<FaultMediaDto>>(
                        $"api/faultreports/{assignment.FaultReportId}/media")
                    ?? new();
                var interventions =
                    await Http.GetFromJsonAsync<List<InterventionDto>>(
                        $"api/interventions/workassignment/{assignment.Id}")
                    ?? new();

                interventionsByAssignment[assignment.Id] =
                    interventions;

                foreach (var intervention in interventions)
                {
                    var materials =
                        await Http.GetFromJsonAsync<List<InterventionMaterialDto>>(
                            $"api/interventions/{intervention.Id}/materials")
                        ?? new();

                    materialsByIntervention[intervention.Id] =
                        materials;

                    mediaByIntervention[intervention.Id] =
                        reportMedia
                            .Where(media =>
                                media.InterventionId ==
                                    intervention.Id)
                            .ToList();

                    if (intervention.FinishedAt is null)
                    {
                        workNotes[intervention.Id] =
                            string.Empty;
                    }
                }
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage =
                $"Radne naloge nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StartIntervention(
        int workAssignmentId)
    {
        errorMessage = null;
        isSaving = true;

        try
        {
            var request =
                new CreateInterventionDto
                {
                    WorkAssignmentId =
                        workAssignmentId
                };

            var response =
                await Http.PostAsJsonAsync(
                    "api/interventions",
                    request);

            if (!response.IsSuccessStatusCode)
            {
                var message =
                    await response.Content
                        .ReadAsStringAsync();

                errorMessage =
                    string.IsNullOrWhiteSpace(message)
                        ? "Intervenciju nije moguće pokrenuti."
                        : message.Trim('"');

                return;
            }

            await LoadAssignments();
        }
        catch (HttpRequestException ex)
        {
            errorMessage =
                $"Intervenciju nije moguće pokrenuti: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task FinishIntervention(
        int interventionId,
        bool isSuccessful)
    {
        errorMessage = null;

        var workNote =
            GetWorkNote(interventionId);

        if (string.IsNullOrWhiteSpace(
                workNote))
        {
            errorMessage =
                "Bilješka rada je obavezna.";

            return;
        }

        isSaving = true;

        try
        {
            var request =
                new FinishInterventionDto
                {
                    WorkNote =
                        workNote.Trim(),

                    IsSuccessful =
                        isSuccessful
                };

            var response =
                await Http.PutAsJsonAsync(
                    $"api/interventions/{interventionId}/finish",
                    request);

            if (!response.IsSuccessStatusCode)
            {
                var message =
                    await response.Content
                        .ReadAsStringAsync();

                errorMessage =
                    string.IsNullOrWhiteSpace(message)
                        ? "Intervenciju nije moguće završiti."
                        : message.Trim('"');

                return;
            }

            await LoadAssignments();
        }
        catch (HttpRequestException ex)
        {
            errorMessage =
                $"Intervenciju nije moguće završiti: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetWorkNote(
        int interventionId)
    {
        return workNotes.TryGetValue(
            interventionId,
            out var value)
            ? value
            : string.Empty;
    }

    private void SetWorkNote(
        int interventionId,
        string value)
    {
        workNotes[interventionId] =
            value;
    }

    private int? GetSelectedMaterial(
    int interventionId)
    {
        return selectedMaterialByIntervention.TryGetValue(
            interventionId,
            out var value)
            ? value
            : null;
    }

    private void SetSelectedMaterial(
        int interventionId,
        int? value)
    {
        selectedMaterialByIntervention[interventionId] =
            value;
    }

    private decimal? GetQuantity(
        int interventionId)
    {
        return quantityByIntervention.TryGetValue(
            interventionId,
            out var value)
            ? value
            : null;
    }

    private void SetQuantity(
        int interventionId,
        decimal? value)
    {
        quantityByIntervention[interventionId] =
            value;
    }

    private async Task AddMaterial(
    int interventionId)
    {
        errorMessage = null;

        var materialId =
            GetSelectedMaterial(
                interventionId);

        var quantity =
            GetQuantity(
                interventionId);

        if (!materialId.HasValue ||
            materialId.Value <= 0)
        {
            errorMessage =
                "Odaberi materijal.";

            return;
        }

        if (!quantity.HasValue ||
            quantity.Value <= 0)
        {
            errorMessage =
                "Količina materijala mora biti veća od nule.";

            return;
        }

        isSaving = true;

        try
        {
            var request =
                new SaveInterventionMaterialDto
                {
                    MaterialId =
                        materialId.Value,

                    Quantity =
                        quantity.Value
                };

            var response =
                await Http.PostAsJsonAsync(
                    $"api/interventions/{interventionId}/materials",
                    request);

            if (!response.IsSuccessStatusCode)
            {
                var message =
                    await response.Content
                        .ReadAsStringAsync();

                errorMessage =
                    string.IsNullOrWhiteSpace(message)
                        ? "Materijal nije moguće evidentirati."
                        : message.Trim('"');

                return;
            }

            selectedMaterialByIntervention[interventionId] =
                null;

            quantityByIntervention[interventionId] =
                null;

            await LoadAssignments();
        }
        catch (HttpRequestException ex)
        {
            errorMessage =
                $"Materijal nije moguće evidentirati: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void HandleAfterPhotoSelected(
    int interventionId,
    InputFileChangeEventArgs args)
    {
        afterPhotoByIntervention[interventionId] =
            args.File;

        errorMessage = null;
    }

    private void HandleDocumentSelected(
        int interventionId,
        InputFileChangeEventArgs args)
    {
        documentByIntervention[interventionId] =
            args.File;

        errorMessage = null;
    }

    private IBrowserFile? GetAfterPhoto(
        int interventionId)
    {
        return afterPhotoByIntervention.TryGetValue(
            interventionId,
            out var file)
            ? file
            : null;
    }

    private IBrowserFile? GetDocument(
        int interventionId)
    {
        return documentByIntervention.TryGetValue(
            interventionId,
            out var file)
            ? file
            : null;
    }

    private async Task UploadAfterPhoto(
        int faultReportId,
        int interventionId)
    {
        var file =
            GetAfterPhoto(
                interventionId);

        if (file is null)
        {
            errorMessage =
                "Odaberi fotografiju.";

            return;
        }

        await UploadMedia(
            faultReportId,
            interventionId,
            file,
            "after-photo");

        afterPhotoByIntervention[interventionId] =
            null;
    }

    private async Task UploadDocument(
        int faultReportId,
        int interventionId)
    {
        var file =
            GetDocument(
                interventionId);

        if (file is null)
        {
            errorMessage =
                "Odaberi PDF dokument.";

            return;
        }

        await UploadMedia(
            faultReportId,
            interventionId,
            file,
            "document");

        documentByIntervention[interventionId] =
            null;
    }

    private async Task UploadMedia(
        int faultReportId,
        int interventionId,
        IBrowserFile file,
        string endpoint)
    {
        errorMessage = null;

        if (file.Size > MaxFileSize)
        {
            errorMessage =
                "Datoteka smije imati najviše 10 MB.";

            return;
        }

        isUploading = true;

        try
        {
            using var form =
                new MultipartFormDataContent();

            await using var stream =
                file.OpenReadStream(
                    MaxFileSize);

            using var fileContent =
                new StreamContent(
                    stream);

            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(
                    file.ContentType);

            form.Add(
                fileContent,
                "file",
                file.Name);

            var response =
                await Http.PostAsync(
                    $"api/faultreports/{faultReportId}/media/interventions/{interventionId}/{endpoint}",
                    form);

            if (!response.IsSuccessStatusCode)
            {
                var message =
                    await response.Content
                        .ReadAsStringAsync();

                errorMessage =
                    string.IsNullOrWhiteSpace(message)
                        ? "Privitak nije moguće učitati."
                        : message.Trim('"');

                return;
            }

            await LoadAssignments();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Privitak nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task DeleteMedia(
        int faultReportId,
        int mediaId)
    {
        var confirmed =
            await DialogService.ShowMessageBoxAsync(
                "Brisanje privitka",
                "Želiš li sigurno izbrisati ovaj privitak?",
                yesText: "Izbriši",
                cancelText: "Odustani");

        if (confirmed != true)
        {
            return;
        }

        errorMessage = null;

        try
        {
            var response =
                await Http.DeleteAsync(
                    $"api/faultreports/{faultReportId}/media/{mediaId}");

            if (!response.IsSuccessStatusCode)
            {
                var message =
                    await response.Content
                        .ReadAsStringAsync();

                errorMessage =
                    string.IsNullOrWhiteSpace(message)
                        ? "Privitak nije moguće izbrisati."
                        : message.Trim('"');

                return;
            }

            await LoadAssignments();
        }
        catch (HttpRequestException ex)
        {
            errorMessage =
                $"Privitak nije moguće izbrisati: {ex.Message}";
        }
    }

    private static string GetMediaPurposeLabel(
        string purpose)
    {
        return purpose switch
        {
            "AfterPhoto" =>
                "Fotografija nakon rada",

            "Document" =>
                "Dokument",

            _ =>
                purpose
        };
    }

    private static string FormatBytes(
        long bytes)
    {
        return bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.0} MB"
            : $"{bytes / 1024d:0.0} KB";
    }
}
@page "/employees"
@rendermode InteractiveServer

@using eKvarovi.Shared.DTOs
@using System.Net.Http.Json

@inject HttpClient Http
@inject IDialogService DialogService

<MudText Typo="Typo.h4" GutterBottom="true">Djelatnici</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudTextField @bind-Value="searchString"
                          Label="Pretraži djelatnike"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>

        <MudItem xs="12" md="5">
            <MudSelect T="int?"
                       Label="Lokacija"
                       @bind-Value="selectedLocationId"
                       Variant="Variant.Outlined"
                       Clearable="true">

                @foreach (var location in locations)
                {
                    <MudSelectItem T="int?"
                                   Value="@((int?)location.Id)">
                        @location.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Spacing="2" Class="mt-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="LoadEmployees">
            Primijeni filtere
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   OnClick="ResetFilters">
            Reset filtera
        </MudButton>
    </MudStack>
</MudPaper>

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary" />
    </div>
}
else
{
    <MudButton Href="/employees/create"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add">
        Novi djelatnik
    </MudButton>

    <MudTable Items="FilteredEmployees"
              Hover="true"
              Striped="true"
              Bordered="true"
              Dense="true">

        <HeaderContent>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<EmployeeDto, object>(x => x.LastName)">
                    Djelatnik
                </MudTableSortLabel>
            </MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Telefon</MudTh>
            <MudTh>Lokacija</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Uredi</MudTh>
            <MudTh>Obriši</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Djelatnik">
                @context.FirstName @context.LastName
            </MudTd>

            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Telefon">@context.Phone</MudTd>
            <MudTd DataLabel="Lokacija">@context.LocationName</MudTd>

            <MudTd DataLabel="Status">
                <MudChip T="string"
                         Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Aktivan" : "Neaktivan")
                </MudChip>
            </MudTd>

            <MudTd DataLabel="Uredi">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Href="@($"/employees/edit/{context.Id}")" />
            </MudTd>

            <MudTd DataLabel="Obriši">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="@(() => DeleteEmployee(context))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Typo="Typo.body1" Class="pa-4">
                Nema rezultata za zadane kriterije pretrage i filtera.
            </MudText>
        </NoRecordsContent>

    </MudTable>
}

@code {
    private List<EmployeeDto> employees = new();
    private List<LocationDto> locations = new();

    private string searchString = string.Empty;
    private int? selectedLocationId;

    private bool isLoading = true;
    private string? errorMessage;

    private IEnumerable<EmployeeDto> FilteredEmployees =>
        employees.Where(EmployeeMatchesSearch);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadLocations();
            await LoadEmployees();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Greška kod učitavanja stranice: {ex.Message}";

            isLoading = false;
        }
    }

    private async Task LoadLocations()
    {
        locations =
            await Http.GetFromJsonAsync<List<LocationDto>>(
                "api/locations")
            ?? new();
    }

    private async Task LoadEmployees()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var query = new List<string>();

            if (selectedLocationId.HasValue)
            {
                query.Add(
                    $"locationId={selectedLocationId.Value}");
            }

            var url = "api/employees";

            if (query.Count > 0)
            {
                url += "?" + string.Join("&", query);
            }

            employees =
                await Http.GetFromJsonAsync<List<EmployeeDto>>(url)
                ?? new();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Greška kod dohvaćanja djelatnika: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool EmployeeMatchesSearch(EmployeeDto employee)
    {
        if (string.IsNullOrWhiteSpace(searchString))
        {
            return true;
        }

        return employee.FirstName.Contains(
                   searchString,
                   StringComparison.OrdinalIgnoreCase)
               || employee.LastName.Contains(
                   searchString,
                   StringComparison.OrdinalIgnoreCase)
               || employee.Email.Contains(
                   searchString,
                   StringComparison.OrdinalIgnoreCase)
               || (employee.Phone ?? string.Empty).Contains(
                   searchString,
                   StringComparison.OrdinalIgnoreCase)
               || employee.LocationName.Contains(
                   searchString,
                   StringComparison.OrdinalIgnoreCase);
    }

    private async Task ResetFilters()
    {
        searchString = string.Empty;
        selectedLocationId = null;

        await LoadEmployees();
    }

    private async Task DeleteEmployee(EmployeeDto employee)
    {
        try
        {
            var confirmed =
                await DialogService.ShowMessageBoxAsync(
                    "Brisanje djelatnika",
                    $"Želite li obrisati djelatnika '{employee.FirstName} {employee.LastName}'?",
                    yesText: "Da",
                    noText: "Ne");

            if (confirmed != true)
            {
                return;
            }

            var response =
                await Http.DeleteAsync(
                    $"api/employees/{employee.Id}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    await response.Content.ReadAsStringAsync();

                return;
            }

            await LoadEmployees();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Greška kod brisanja djelatnika: {ex.Message}";
        }
    }
}